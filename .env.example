# Copy to .env.local (never commit it) and restart `npm run dev`.
# Used only by the dev server's /api/ai/draft endpoint; it is never sent to the browser.
ANTHROPIC_API_KEY=

# Optional: set to "off" to skip the server-side refusal-fallback beta.
# AI_FALLBACKS=off

# Web Analytics scan: a free Google PageSpeed Insights API key (APIs & Services > Library > PageSpeed Insights API > Credentials).
# Without it the scan still works, with a much lower quota. Never prefix with VITE_ (that would expose it to the browser).
PAGESPEED_API_KEY=

# Optional: the deployed app's address, so Web Analytics scans the live profile page even when you run locally.
# Example: VITE_SITE_URL=https://your-app.vercel.app   (a public address, no trailing path)
VITE_SITE_URL=
